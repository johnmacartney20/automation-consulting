# Firecrawl API key — get one at https://firecrawl.dev
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# Google Sheets configuration
# The ID found in the sheet URL: https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# Sheet name and cell range to read, e.g. "Sheet1!A2:A100" (A2 skips header row)
GOOGLE_SHEET_RANGE=Sheet1!A2:A100

# Path to your Google service account credentials JSON file
GOOGLE_SERVICE_ACCOUNT_FILE=credentials.json

# Directory where scraped output will be stored (created automatically)
OUTPUT_DIR=output
